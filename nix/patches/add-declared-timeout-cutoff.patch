diff --git a/runtest.sh b/runtest.sh
index 8bf9b10..a4edb60 100755
--- a/runtest.sh
+++ b/runtest.sh
@@ -234,5 +234,8 @@ Options:
                        TIME (if not specified, $DEFAULT_TIMEOUT or whatever is
                        specified by --timeout, whichever is longer).
+ --skip-declared-longer=TIME: Skip tests whose declared timeout is longer
+                              than TIME, independently of the default specified
+                              by --timeout.
  --ignore-timeouts: Treat all timeouts as not being failures.  (For use when
                     testing under load.)
  --testsuites=SUITES: Which testsuites (directories under test/) to run,
@@ -269,5 +272,6 @@ VALGRIND=${DTRACE_TEST_VALGRIND:+t}
 COMPARISON=t
 SKIP_LONGER=
+SKIP_DECLARED_LONGER=
 
 if [[ -n $DTRACE_TEST_TESTSUITES ]]; then
     TESTSUITES="${DTRACE_TEST_TESTSUITES}"
@@ -307,6 +311,7 @@ while [[ $# -gt 0 ]]; do
         --ignore-timeouts) IGNORE_TIMEOUTS=t;;
 	--skip-longer) SKIP_LONGER=$TIMEOUT;;
 	--skip-longer=*) SKIP_LONGER="$(printf -- $1 | cut -d= -f2-)";;
+	--skip-declared-longer=*) SKIP_DECLARED_LONGER="$(printf -- $1 | cut -d= -f2-)";;
         --testsuites=*) TESTSUITES="$(printf -- $1 | cut -d= -f2- | tr "," " ")";;
         --quiet) QUIET=t;;
         --verbose) QUIET=;;
@@ -969,9 +974,18 @@ for _test in $TESTS; do
 
         # Per-test timeout.
 
+        declared_timeout=
         if exist_options timeout $_test; then
-            if [[ "$(extract_options timeout $_test)" -gt $timeout ]]; then
-                timeout="$(extract_options timeout $_test)"
+            declared_timeout="$(extract_options timeout $_test)"
+
+            if [[ -n $SKIP_DECLARED_LONGER ]] &&
+               [[ $declared_timeout -gt $SKIP_DECLARED_LONGER ]]; then
+                sum "$_test: SKIP: declared timeout exceeds cutoff\n"
+                continue
+            fi
+
+            if [[ $declared_timeout -gt $timeout ]]; then
+                timeout=$declared_timeout
 
                 if [[ -n $VALGRIND ]]; then
                     timeout=$((timeout * 10))
