+	/*
+	 * Version 2 makes the namespace list part of the public debugger ABI.
+	 * Bound traversal by glibc's maximum namespace count so a corrupt child
+	 * cannot make us loop forever.
+	 */
+	if (rd->r_version >= 2) {
+		addr = r_debug(rd->P);
+		for (nns = 0; addr != 0 && nns < DL_NNS; nns++)
