From: dtrace.nix maintainers
Subject: libproc: use the public glibc r_debug v2 namespace chain

glibc 2.35 introduced r_debug protocol version 2.  Its public
r_debug_extended structure links one r_debug record per loader namespace.
Use that protocol directly instead of rejecting it and falling back to the
base namespace.  Keep checking the protocol version after r_brk is cached,
because glibc upgrades the base record from version 1 when it creates the
first secondary namespace.

Keep the private _rtld_global probing only for version 1, where the public ABI
does not expose secondary namespaces.  Version 2 also reports consistency for
every namespace through the normal debugger rendezvous, so it no longer needs
the private loader-lock heuristic.

diff --git a/libproc/rtld_db.c b/libproc/rtld_db.c
--- a/libproc/rtld_db.c
+++ b/libproc/rtld_db.c
@@ -244,26 +244,70 @@ find_dl_nns(rd_agent_t *rd)
 	return 0;
 }
 
+/*
+ * Follow the public r_debug_extended chain introduced by glibc's version 2
+ * debugger protocol.  struct r_debug is the first member, so r_next follows
+ * it at the generated target-ABI size of struct r_debug.
+ */
+static uintptr_t
+next_ns_debug(rd_agent_t *rd, uintptr_t addr)
+{
+	uintptr_t next;
+	size_t r_debug_size = rd->P->elf64 ? R_DEBUG_64_SIZE :
+	    R_DEBUG_32_SIZE;
+	size_t ptr_size = rd->P->elf64 ? PTR_64_SIZE : PTR_32_SIZE;
+
+	if (Pread_scalar(rd->P, &next, ptr_size, sizeof(uintptr_t),
+		addr + r_debug_size) < 0) {
+		_dprintf("%i: Cannot read next namespace debug record\n",
+		    rd->P->pid);
+		return 0;
+	}
+
+	return next;
+}
