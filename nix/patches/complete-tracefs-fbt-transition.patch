From: dtrace.nix maintainers
Subject: fbt: remove obsolete kallsyms enumeration path

FBT probe discovery now uses tracefs and BTF directly.  Remove the unreachable
kallsyms-based implementation and its state so the provider has one canonical
discovery path.

--- a/libdtrace/dt_prov_fbt.c
+++ b/libdtrace/dt_prov_fbt.c
@@ -235,13 +235,8 @@ provide_tracefs(dtrace_hdl_t *dtp, const dtrace_probedesc_t *pdp, int prb,
 
 static int provide(dtrace_hdl_t *dtp, const dtrace_probedesc_t *pdp)
 {
-	int			n = 0;
 	int			prb = 0;
 	int			rawfbt = 0;
-	dt_module_t		*dmp = NULL;
-	dt_symbol_t		*sym = NULL;
-	dt_htab_next_t		*it = NULL;
-	dtrace_probedesc_t	pd;
 
 	/*
 	 * Nothing to do if a probe name is specified and cannot match 'entry'
@@ -265,119 +260,6 @@ static int provide(dtrace_hdl_t *dtp, const dtrace_probedesc_t *pdp)
 		rawfbt = 1;
 
 	return provide_tracefs(dtp, pdp, prb, rawfbt);
-
-	/*
-	 * If we have an explicit module name, check it.  If not found, we can
-	 * ignore this request.
-	 */
-	if (pdp->mod[0] != '\0' && strchr(pdp->mod, '*') == NULL) {
