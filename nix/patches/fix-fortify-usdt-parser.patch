 			usdt_parser_write_one(out, msg, msg->size);
 	
@@ -678,7 +683,8 @@ emit_provider(int out, const dof_helper_t *dhp, const dt_provider_t *pvp)
 	if ((msg = alloc_msg(out, DIT_PROVIDER, strlen(pvp->name) + 1)) == NULL)
