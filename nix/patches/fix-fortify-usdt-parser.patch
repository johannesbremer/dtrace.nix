From: NixOS DTrace maintainers
Subject: libcommon: address trailing message storage through allocation base

The parser protocol uses one-byte trailing arrays as variable-sized message
payloads.  With _FORTIFY_SOURCE=3, glibc sees each declared member as one byte
and aborts writes of longer provider, probe, argument, or error data, even
though each message was allocated with enough trailing storage.

Address payloads through the allocation base and their protocol offsets.  This
retains the protocol layout and bounds checking against the complete dynamic
allocation while avoiding the misleading one-byte subobject bound.

diff --git a/libcommon/usdt_parser.c b/libcommon/usdt_parser.c
index 8641980..b490740 100644
--- a/libcommon/usdt_parser.c
+++ b/libcommon/usdt_parser.c
@@ -50,7 +50,8 @@ usdt_error(int out, int err_no, const char *fmt, ...)
 	parsed->size = sz;
 	parsed->type = DIT_ERR;
 	parsed->err.err_no = err_no;
-	strcpy(parsed->err.err, msg);
+	memcpy((char *)parsed + offsetof(dof_parsed_t, err.err), msg,
+	       strlen(msg) + 1);
 
 	usdt_parser_write_one(out, parsed, parsed->size);
 	free(parsed);
diff --git a/libcommon/usdt_parser_dof.c b/libcommon/usdt_parser_dof.c
index bc8e185..147fafb 100644
--- a/libcommon/usdt_parser_dof.c
+++ b/libcommon/usdt_parser_dof.c
@@ -765,7 +765,8 @@ emit_probe(int out, dtrace_helper_probedesc_t *dhpb)
 	msg->probe.nargc = dhpb->dthpb_nargc;
 	msg->probe.xargc = dhpb->dthpb_xargc;
 
-	ptr = stpcpy(msg->probe.name, dhpb->dthpb_mod);
+	ptr = (char *)msg + offsetof(dof_parsed_t, probe.name);
+	ptr = stpcpy(ptr, dhpb->dthpb_mod);
 	ptr++;
 	ptr = stpcpy(ptr, dhpb->dthpb_func);
 	ptr++;
@@ -796,7 +797,8 @@ emit_probe(int out, dtrace_helper_probedesc_t *dhpb)
 
 		msg->size = msg_size;
 		msg->type = DIT_ARGS_NATIVE;
-		memcpy(msg->nargs.args, dhpb->dthpb_ntypes, nargs_size);
+		memcpy((char *)msg + offsetof(dof_parsed_t, nargs.args),
+		       dhpb->dthpb_ntypes, nargs_size);
 		usdt_parser_write_one(out, msg, msg_size);
 
 		free(msg);
@@ -819,7 +821,8 @@ emit_probe(int out, dtrace_helper_probedesc_t *dhpb)
 
 			msg->size = msg_size;
 			msg->type = DIT_ARGS_XLAT;
-			memcpy(msg->xargs.args, dhpb->dthpb_xtypes, xargs_size);
+			memcpy((char *)msg + offsetof(dof_parsed_t, xargs.args),
+			       dhpb->dthpb_xtypes, xargs_size);
 			usdt_parser_write_one(out, msg, msg_size);
 
 			free(msg);
@@ -838,7 +841,8 @@ emit_probe(int out, dtrace_helper_probedesc_t *dhpb)
 
 			msg->size = msg_size;
 			msg->type = DIT_ARGS_MAP;
-			memcpy(msg->argmap.argmap, dhpb->dthpb_args, map_size);
+			memcpy((char *)msg + offsetof(dof_parsed_t, argmap.argmap),
+			       dhpb->dthpb_args, map_size);
 			usdt_parser_write_one(out, msg, msg_size);
 			free(msg);
 		}
@@ -935,7 +939,8 @@ emit_provider(int out, dof_helper_t *dhp,
 	provider_msg->size = provider_msg_size;
 	provider_msg->type = DIT_PROVIDER;
 	provider_msg->provider.nprobes = prb_sec->dofs_size / prb_sec->dofs_entsize;
-	strcpy(provider_msg->provider.name, dhpb.dthpb_prov);
+	memcpy((char *)provider_msg + offsetof(dof_parsed_t, provider.name),
+	       dhpb.dthpb_prov, strlen(dhpb.dthpb_prov) + 1);
 	usdt_parser_write_one(out, provider_msg, provider_msg_size);
 
 	/*
