 			usdt_parser_write_one(out, msg, msg->size);
 	
@@ -650,7 +654,8 @@ emit_probe(int out, const dof_helper_t *dhp, const dt_probe_t *prp)
 			if ((msg = alloc_msg(out, DIT_ARGS_MAP, mapsz)) == NULL)
