From: dtrace.nix maintainers
Subject: tests: synchronize fixtures and measure scheduler behavior robustly

Remove remaining fixed-delay process races exposed by software-emulated guests:
keep exec-loop targets alive until their owning runner releases them, wait for
the particular deferred USDT probe needed by each target, and launch the raise
target through DTrace's synchronized -c path.

Measure switchrate relative to interleaved fastest samples so variable compile
overhead cannot masquerade as scheduler delay.  Generate the MIB test's UDP
traffic locally instead of relying on the obsolete rup utility.

--- a/test/triggers/execloop
+++ b/test/triggers/execloop
@@ -4,17 +4,12 @@
 # http://oss.oracle.com/licenses/upl.
 
 if [[ -z $LOOP ]]; then
-    export LOOP=0
-    export END=`date +'%s' -d '+10 secs'`
+    LOOP=0
 fi
 
-if [[ `date +'%s'` -ge $END ]]; then
-    exit 0
-fi
-#if [[ $LOOP -eq 10000000 ]]; then
-#    exit 0
-#fi
+export LOOP=$((LOOP + 1))
 
-LOOP=$(($LOOP+1))
-
+# The testsuite owns and terminates this trigger after DTrace has grabbed it.
+# Keep execing until then so slow attachment cannot race a fixed deadline.
+sleep 0.01
 exec $0
--- a/test/triggers/usdt-tst-defer.c
+++ b/test/triggers/usdt-tst-defer.c
@@ -56,8 +56,19 @@
 		TESTPROV_FOO();
 	}
 
-	/* wait for probes to get set up */
-	usleep(500 * 1000);
+	/*
+	 * Processes whose provider name ends in 0 through 4 are also matched by
+	 * the bar clauses.  Deferred discovery enables each clause separately,
+	 * so wait for bar itself instead of assuming a fixed setup delay.
+	 */
+	if (getpid() % 10 < 5) {
+		for (i = 0; i < 12000 && !TESTPROV_BAR_ENABLED(); i++)
+			usleep(10 * 1000);
+		if (!TESTPROV_BAR_ENABLED()) {
+			fprintf(stderr, "bar probe was not enabled\n");
+			return 1;
+		}
+	}
 
 	/* in phase 2, just loop over probe "bar" a fixed number of times */
 	for (i = 0; i < 10; i++) {
