 int
 dt_btf_func_is_void(dtrace_hdl_t *dtp, const dt_btf_t *btf, uint32_t id)
 {
-	btf_type_t	*type = dt_btf_type_by_id(dtp, btf, id);
-
-	/* For functions, move on to the function prototype. */
-	if (BTF_INFO_KIND(type->info) == BTF_KIND_FUNC)
-		type = dt_btf_type_by_id(dtp, btf, type->type);
+	btf_type_t	*type = dt_btf_real_type_by_id(dtp, btf, id);
 
-	if (BTF_INFO_KIND(type->info) == BTF_KIND_FUNC_PROTO &&
-	    type->type == 0)
+	if (type != NULL &&
+	    BTF_INFO_KIND(type->info) == BTF_KIND_FUNC_PROTO && type->type == 0)
 		return 1;
 
 	return 0;
 }
+
+/*
+ * Return 1 if the function referenced by the BTF id can be traced using the
+ * fprobe/fexit facility.  Specifically, that the function is not variadic,
+ * that every argument and return value has a supported BTF representation,
+ * and that no argument exceeds the acceptable value size (16 bytes).  See
+ * btf_distill_func_proto() and btf_ctx_access() in kernel/bpf/btf.c.
+ */
+int
+dt_btf_func_is_traceable(dtrace_hdl_t *dtp, const dt_btf_t *btf, uint32_t id)
+{
+	btf_type_t	*type = dt_btf_real_type_by_id(dtp, btf, id);
+	uint32_t	kind;
+	int		argc;
+
+	/* If no prototype is found, BPF fprobes do not work. */
+	if (!type || BTF_INFO_KIND(type->info) != BTF_KIND_FUNC_PROTO)
+		return 0;
+
+	/*
+	 * Match the types accepted by __get_type_size() in kernel/bpf/btf.c.
+	 * A void return is valid, but aggregate and unsized return types are not.
+	 */
+	if (type->type != 0) {
+		btf_type_t	*rtype = dt_btf_real_type_by_id(dtp, btf, type->type);
+
+		if (rtype == NULL)
+			return 0;
+
+		kind = BTF_INFO_KIND(rtype->info);
+		if (kind == BTF_KIND_PTR) {
+			if (!dt_btf_ptr_is_traceable(dtp, btf, rtype))
+				return 0;
+		} else if (kind != BTF_KIND_INT &&
+		    kind != BTF_KIND_ENUM && kind != BTF_KIND_ENUM64)
+			return 0;
+	}
+
+	argc = BTF_INFO_VLEN(type->info);
+	if (argc > 0) {
+		btf_param_t	*args = (btf_param_t *)(type + 1);
+		int		i;
+
+		if (args[argc - 1].type == 0)
+			return 0;
+
+		for (i = 0; i < argc; i++) {
+			type = dt_btf_real_type_by_id(dtp, btf, args[i].type);
+			if (type == NULL)
+				return 0;
+
+			kind = BTF_INFO_KIND(type->info);
+			switch (kind) {
+			case BTF_KIND_PTR:
+				if (!dt_btf_ptr_is_traceable(dtp, btf, type))
+					return 0;
+				break;
+			case BTF_KIND_INT:
+			case BTF_KIND_ENUM:
+			case BTF_KIND_ENUM64:
+			case BTF_KIND_STRUCT:
+			case BTF_KIND_UNION:
+				if (type->size == 0 || type->size > 16)
+					return 0;
+				break;
+			default:
+				return 0;
+			}
+		}
+	}
+
+	return 1;
+}
