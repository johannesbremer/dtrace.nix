From: dtrace.nix maintainers
Subject: btf,fbt: do not provide functions unsupported by BPF fprobes

Backport Oracle DTrace commits 57d4e672, 135bcb8d, a4444618, and f6b98465,
then extend their eligibility check to match the tracing-context verifier.
BPF fentry/fexit cannot attach to variadic functions, functions returning a
struct or union, functions with oversized aggregate arguments, or parameters
whose BTF kind has no supported fprobe context representation.  Filter those
functions while providing FBT probes instead of failing later while loading
one program from a wildcard enabling.

diff --git a/libdtrace/dt_btf.c b/libdtrace/dt_btf.c
--- a/libdtrace/dt_btf.c
+++ b/libdtrace/dt_btf.c
@@ -848,8 +848,61 @@ dt_btf_type_by_id(dtrace_hdl_t *dtp, const dt_btf_t *btf, int32_t id)
 	return btf->types[id - (dtp->dt_shared_btf->type_cnt - 1)];
 }
 
+static btf_type_t *
+dt_btf_real_type_by_id(dtrace_hdl_t *dtp, const dt_btf_t *btf, int32_t id)
+{
+	btf_type_t	*type = dt_btf_type_by_id(dtp, btf, id);
+
+	while (type != NULL) {
+		switch (BTF_INFO_KIND(type->info)) {
+		case BTF_KIND_CONST:
+		case BTF_KIND_FUNC:
+		case BTF_KIND_RESTRICT:
+		case BTF_KIND_TYPEDEF:
+		case BTF_KIND_TYPE_TAG:
+		case BTF_KIND_VOLATILE:
+			type = dt_btf_type_by_id(dtp, btf, type->type);
+			break;
+		default:
+			return type;
+		}
+	}
+
+	return NULL;
+}
+
+/*
+ * Kernels without multi-level-pointer trampoline support (including 6.18)
+ * permit tracing-context access to pointers to void, integers, structs, and
+ * unions.  Other pointer targets fail btf_ctx_access().
+ */
+static int
+dt_btf_ptr_is_traceable(dtrace_hdl_t *dtp, const dt_btf_t *btf,
+			const btf_type_t *type)
+{
+	btf_type_t	*target;
+
+	if (type == NULL || BTF_INFO_KIND(type->info) != BTF_KIND_PTR)
+		return 0;
+	if (type->type == 0)
+		return 1;
+
+	target = dt_btf_real_type_by_id(dtp, btf, type->type);
+	if (target == NULL)
+		return 0;
+
+	switch (BTF_INFO_KIND(target->info)) {
+	case BTF_KIND_INT:
+	case BTF_KIND_STRUCT:
+	case BTF_KIND_UNION:
+		return 1;
+	default:
+		return 0;
+	}
+}
