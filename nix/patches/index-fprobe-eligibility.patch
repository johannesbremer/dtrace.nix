+/*
+ * fexit cannot attach to these noreturn functions.  This list mirrors the
+ * kernel verifier's noreturn_deny BTF set.  The kernel currently maintains
+ * the set explicitly because noreturn is not represented in function BTF.
+ */
+static int
+fprobe_is_noreturn(const char *name)
+{
+	static const char *const noreturn[] = {
+		"__ia32_sys_exit",
+		"__ia32_sys_exit_group",
+		"__kunit_abort",
+		"__module_put_and_kthread_exit",
+		"__x64_sys_exit",
+		"__x64_sys_exit_group",
+		"do_exit",
+		"do_group_exit",
+		"kthread_complete_and_exit",
+		"kthread_exit",
+		"kunit_try_catch_throw",
+		"make_task_dead",
+	};
+	size_t	i;
+
+	for (i = 0; i < sizeof(noreturn) / sizeof(noreturn[0]); i++) {
+		if (strcmp(name, noreturn[i]) == 0)
+			return 1;
+	}
+
+	return 0;
+}
