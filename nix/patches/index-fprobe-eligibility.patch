+static int
+dt_btf_name_cmp(const void *lhs, const void *rhs)
+{
+	const dt_btf_name_t	*l = lhs;
+	const dt_btf_name_t	*r = rhs;
+	int			rc;
+
+	rc = strcmp(l->name, r->name);
+	if (rc != 0)
+		return rc;
+	if (l->kind != r->kind)
+		return l->kind < r->kind ? -1 : 1;
+	if (l->id != r->id)
+		return l->id < r->id ? -1 : 1;
+	return 0;
+}
+
+static int
+dt_btf_build_name_index(dtrace_hdl_t *dtp, dt_btf_t *btf)
+{
+	dt_btf_name_t	*names;
+	int32_t		i;
+	size_t		n = 0;
+
+	if (btf->names_built)
+		return 0;
+	if (btf->type_cnt <= 1) {
+		btf->names_built = 1;
+		return 0;
+	}
+
+	names = dt_alloc(dtp, (btf->type_cnt - 1) * sizeof(*names));
+	if (names == NULL) {
+		dt_btf_set_errno(dtp, ENOMEM);
+		return -ENOMEM;
+	}
+
+	for (i = 1; i < btf->type_cnt; i++) {
+		const btf_type_t	*type = btf->types[i];
+		const char		*name;
+
+		if (type->name_off == 0)
+			continue;
+		name = dt_btf_get_string(dtp, btf, type->name_off);
+		if (name == NULL || name[0] == '\0')
+			continue;
+
+		names[n].name = name;
+		names[n].kind = BTF_INFO_KIND(type->info);
+		names[n].id = i;
+		n++;
+	}
+
+	qsort(names, n, sizeof(*names), dt_btf_name_cmp);
+	btf->names = names;
+	btf->name_cnt = n;
+	btf->names_built = 1;
+	return 0;
 }
 
+static int32_t
+dt_btf_lookup_name_index(dtrace_hdl_t *dtp, dt_btf_t *btf,
+			 const char *name, uint32_t kind)
+{
+	size_t	lo = 0, hi;
+
+	if (dt_btf_build_name_index(dtp, btf) < 0)
+		return -ENOMEM;
+
+	hi = btf->name_cnt;
+	while (lo < hi) {
+		size_t			mid = lo + (hi - lo) / 2;
+		const dt_btf_name_t	*entry = &btf->names[mid];
+		int			rc = strcmp(entry->name, name);
+
+		if (rc < 0 || (rc == 0 && entry->kind < kind))
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+
+	if (lo < btf->name_cnt && btf->names[lo].kind == kind &&
+	    strcmp(btf->names[lo].name, name) == 0)
+		return btf->names[lo].id;
+
+	return -ENOENT;
+}
