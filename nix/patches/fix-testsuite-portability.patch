 #
 
 dtrace=$1
+raw=$tmpdir/ann-tramp-lvar.raw
 
-$dtrace $dt_flags -xdisasm=2 -Sn '
-BEGIN,
+if ! $dtrace $dt_flags -xdisasm=2 -Sn '
+proc:::exit,
 io:::start
+/pid == $target/
 {
 	exit(0);
 }
-' 2>&1 | gawk '/this->/ {
+' -c /bin/true >"$raw" 2>&1; then
+	cat "$raw"
+	exit 1
+fi
+
+if ! gawk '/this->/ {
 		sub(/^[^:]+: /, "");
 
 		gsub(/%r[0-9]/, "%rX");
 		$2 = "N";
 		$3 = "N";
 
+		found = 1;
 		print;
-         }'
+         }
+
+         END {
+		if (!found)
+			exit 1;
+         }' "$raw"; then
+	cat "$raw"
+	exit 1
+fi
 
-exit $?
+exit 0
