From: dtrace.nix maintainers
Subject: module: parse modern long kallsyms names without overflowing

Linux increased KSYM_NAME_LEN for Rust symbols.  The old unbounded sscanf()
conversion writes names longer than 127 bytes across the adjacent module-name
buffer, inventing modules from fragments of the symbol and corrupting probe
discovery.  Match the modern kernel limit and parse both variable fields with
explicit bounds.

--- a/libdtrace/dt_module.c
+++ b/libdtrace/dt_module.c
@@ -30,7 +30,7 @@
 #include <dt_string.h>
 #include <dt_btf.h>
 
-#define KSYM_NAME_MAX 128		    /* from kernel/scripts/kallsyms.c */
+#define KSYM_NAME_MAX 512		    /* from kernel/include/linux/kallsyms.h */
 #define GZCHUNKSIZE (1024*512)		    /* gzip uncompression chunk size */
 
 static void
@@ -1273,6 +1273,62 @@ typedef struct dt_kallsym {
 	char		mod[PATH_MAX];
 } dt_kallsym_t;
 
+/*
+ * Parse the symbol name and optional "[module]" suffix after the numeric
+ * fields in a /proc/kall[mod]syms line.  Do not use an unbounded sscanf()
+ * conversion here: modern kernels can expose Rust symbols substantially
+ * longer than the historical 128-byte limit.
+ *
+ * Return 0 on success, 1 when an overlong entry should be skipped, and -1
+ * for malformed input.
+ */
+static int
+dt_kallsym_parse_name(const char *p, dt_kallsym_t *sym)
+{
+	const char	*start, *end;
+	size_t		n;
+
+	while (isspace((unsigned char)*p))
+		p++;
+	start = p;
+	while (*p != '\0' && !isspace((unsigned char)*p))
+		p++;
+
+	n = p - start;
+	if (n == 0)
+		return -1;
+	if (n >= sizeof(sym->name))
+		return 1;
+	memcpy(sym->name, start, n);
+	sym->name[n] = '\0';
+
+	strcpy(sym->mod, "vmlinux");
+	while (isspace((unsigned char)*p))
+		p++;
+	if (*p == '\0')
+		return 0;
+	if (*p++ != '[')
+		return -1;
+
+	end = strchr(p, ']');
+	if (end == NULL)
+		return -1;
+	n = end - p;
+	if (n == 0)
+		return -1;
+	if (n >= sizeof(sym->mod))
+		return 1;
+	memcpy(sym->mod, p, n);
+	sym->mod[n] = '\0';
+
+	for (p = end + 1; *p != '\0'; p++) {
+		if (!isspace((unsigned char)*p))
+			return -1;
+	}
+
+	return 0;
+}
+
