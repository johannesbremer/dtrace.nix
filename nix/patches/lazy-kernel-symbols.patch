+/*
+ * Establish the kernel module available directly from BTF and initialize
+ * process-valued macros.  The full address-bearing kernel symbol table is
+ * loaded lazily by the symbol lookup interfaces below.
+ */
+int
+dt_module_bootstrap(dtrace_hdl_t *dtp)
+{
+	dt_module_t	*dmp;
+
+	dmp = dt_module_lookup_by_name(dtp, "vmlinux");
+	if (dmp == NULL)
+		dmp = dt_module_create(dtp, "vmlinux");
+	if (dmp == NULL)
+		return EDT_NOMEM;
+
+	dmp->dm_flags |= DT_DM_KERNEL;
+	dtp->dt_exec = dmp;
+
+	dt_idhash_lookup(dtp->dt_macros, "egid")->di_id = getegid();
+	dt_idhash_lookup(dtp->dt_macros, "euid")->di_id = geteuid();
+	dt_idhash_lookup(dtp->dt_macros, "gid")->di_id = getgid();
+	dt_idhash_lookup(dtp->dt_macros, "pid")->di_id = getpid();
+	dt_idhash_lookup(dtp->dt_macros, "pgid")->di_id = getpgid(0);
+	dt_idhash_lookup(dtp->dt_macros, "ppid")->di_id = getppid();
+	dt_idhash_lookup(dtp->dt_macros, "sid")->di_id = getsid(0);
+	dt_idhash_lookup(dtp->dt_macros, "uid")->di_id = getuid();
+
+	return 0;
+}
