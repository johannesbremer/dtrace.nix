--- a/libdtrace/dt_prov_fbt.c
+++ b/libdtrace/dt_prov_fbt.c
@@ -52,6 +52,7 @@
 static const char		prvname[] = "fbt";
 
 #define KPROBE_EVENTS		TRACEFS "kprobe_events"
+#define FBT_FUNCTIONS		TRACEFS "available_filter_functions"
 
 #define FBT_PROBE_FMT		"dt_%d_%s_%s"
 
@@ -158,6 +159,80 @@ static int provide_probe(dtrace_hdl_t *dtp, dt_module_t *dmp,
 #define FBT_ENTRY	1
 #define FBT_RETURN	2
 
+/*
+ * Enumerate the kernel's canonical attachable-function list directly.  BTF
+ * supplies function prototypes and tracefs supplies fprobe eligibility, so
+ * building a complete address-bearing kallsyms table would be redundant.
+ */
+static int
+provide_tracefs(dtrace_hdl_t *dtp, const dtrace_probedesc_t *pdp, int prb,
+		 int rawfbt)
+{
+	FILE			*f;
+	char			*buf = NULL;
+	size_t			len = 0;
+	int			n = 0;
+	dtrace_probedesc_t	pd;
+
+	f = fopen(FBT_FUNCTIONS, "r");
+	if (f == NULL)
+		return 0;
+
+	while (getline(&buf, &len, f) >= 0) {
+		char		*fun = buf;
+		char		*mod = "vmlinux";
+		char		*p;
+		dt_module_t	*dmp;
+
+		p = strchr(buf, '\n');
+		if (p != NULL)
+			*p = '\0';
+		p = strchr(buf, ' ');
+		if (p != NULL) {
+			*p++ = '\0';
+			if (*p == '[')
+				p++;
+			mod = p;
+			p = strchr(mod, ']');
+			if (p != NULL)
+				*p = '\0';
+		}
+
+		if (strncmp(fun, "__ftrace_invalid_address__", 26) == 0 ||
+		    strncmp(fun, "__probestub_", 12) == 0 ||
+		    strncmp(fun, "__traceiter_", 12) == 0 ||
+		    (!rawfbt && strchr(fun, '.')) ||
+		    !dt_gmatch(fun, pdp->fun) || !dt_gmatch(mod, pdp->mod))
+			continue;
+
+		dmp = dt_module_lookup_by_name(dtp, mod);
+		if (dmp == NULL)
+			dmp = dt_module_create(dtp, mod);
+		if (dmp == NULL)
+			continue;
+		dmp->dm_flags |= DT_DM_KERNEL;
+
+		pd.id = DTRACE_IDNONE;
+		pd.prv = pdp->prv;
+		pd.fun = fun;
+
+		if (prb & FBT_ENTRY) {
+			pd.prb = "entry";
+			n += provide_probe(dtp, dmp, &pd);
+		}
+		if (prb & FBT_RETURN) {
+			pd.prb = "return";
+			n += provide_probe(dtp, dmp, &pd);
+		}
+	}
+
+	free(buf);
+	fclose(f);
+	if (!rawfbt && dt_btf_get_module_ids(dtp) < 0)
+		return -1;
+	return n;
+}
+
 static int provide(dtrace_hdl_t *dtp, const dtrace_probedesc_t *pdp)
 {
 	int			n = 0;
@@ -258,6 +332,8 @@ static int provide(dtrace_hdl_t *dtp, const dtrace_probedesc_t *pdp)
